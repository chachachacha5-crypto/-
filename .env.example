# eBay Developer 認証情報（https://developer.ebay.com/ で取得）
# 未設定でもアプリは「サンプルモード」で起動します。
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENVIRONMENT=PRODUCTION
EBAY_MARKETPLACE_ID=EBAY_US

# 利益計算の既定値（UI から上書き可能）
DEFAULT_USD_JPY=155.0
DEFAULT_EBAY_FVF_PERCENT=13.25
DEFAULT_EBAY_FIXED_FEE_USD=0.40
DEFAULT_INTL_FEE_PERCENT=1.65
DEFAULT_PAYOUT_FX_PERCENT=3.0
DEFAULT_AD_FEE_PERCENT=0.0
